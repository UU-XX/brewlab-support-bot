# Copy to .env and fill in locally. Never commit real credentials.
# DeepSeek is the default; set LLM_PROVIDER=openai to use OpenAI instead.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# The Sheet model setting overrides this fallback.
LLM_MODEL=deepseek-flash

# Google Desktop OAuth files, kept outside version control.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Spreadsheet with settings and log tabs.
SPREADSHEET_ID=your_spreadsheet_id_here

# The authenticated support mailbox, used to identify outgoing history.
SUPPORT_EMAIL=support@brewlab.example

# Persistent deduplication and recovery state. Do not discard during recovery.
STATE_FILE=state/bot_state.json

# Polling interval in seconds; batching still waits for 120 seconds of silence.
POLL_INTERVAL=60
